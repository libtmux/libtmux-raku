use v6.d;
use lib $?FILE.IO.parent(3).add('lib');
use Test;
use JSON::Fast;
use Scripts::Filesystem;

# The script finds its repository from its own path, so a copy in a throwaway
# repository checks that repository's files.
my $script = $?FILE.IO.parent.parent.add('check-source.raku');
my $root = private-directory('libtmux-source');
LEAVE remove-tree($root) if $root.defined && $root.e;

sub put(Str:D $relative, Str:D $text) {
    $root.add($relative).parent.mkdir;
    $root.add($relative).spurt($text);
}

sub check() {
    my $process = run $*EXECUTABLE.Str, $root.add('scripts/check-source/check-source.raku').Str,
        :out, :err;
    ($process.exitcode, $process.out.slurp(:close), $process.err.slurp(:close))
}

die 'Could not create a repository' if (run 'git', '-C', $root.Str, 'init', '--quiet').exitcode;
put('scripts/check-source/check-source.raku', $script.slurp);
put('META6.json', to-json(%(provides => %(LibTmux => 'lib/LibTmux.rakumod'), resources => [])) ~ "\n");
put('lib/LibTmux.rakumod', "use v6.d;\nunit module LibTmux;\n");
my @guides = <CONTRIBUTING.md RELEASE.md SCRIPTS.md WRITING.md>;
put(".github/$_", "# Guide\n") for @guides;
put('AGENTS.md', "# Agents\n");
my $link = $root.add('CLAUDE.md');
sub link-agents(Str:D $target = 'AGENTS.md') {
    $link.unlink if $link.e || $link.l;
    die 'Could not link CLAUDE.md' unless symlink($target, $link.Str, :!absolute);
}
link-agents();

my ($status, $out, $err) = check();
is $status, 0, 'a clean repository passes';

my @faults =
    'README.md', "text \n", 'trailing whitespace', 'trailing whitespace is found',
    'README.md', "text", 'missing final LF', 'a missing final newline is found',
    'README.md', "text\r\n", 'CR line endings', 'CR line endings are found',
    'README.md', "[gone](missing.md)\n", 'missing relative link target', 'a broken link is found',
    'README.md', "```sh\nls\n```\n", 'shell examples must use console fences', 'a shell fence is found',
    'lib/Extra.rakumod', "unit module Extra;\n", 'missing stable language declaration', 'a module without use v6.d is found',
    'resources/data.txt', "data\n", 'resources does not match', 'a resource missing from META6.json is found',
    'CONTRIBUTING.md', "# Contributing\n", 'belongs under .github', 'a guide outside .github is found';
for @faults -> $path, $text, $message, $name {
    my $file = $root.add($path);
    put($path, $text);
    ($status, $out, $err) = check();
    isnt $status, 0, $name;
    like $err, /$message/, "$name by its message";
    $file.unlink;
}

for @guides -> $guide {
    my $file = $root.add('.github').add($guide);
    my $text = $file.slurp;
    $file.unlink;
    ($status, $out, $err) = check();
    isnt $status, 0, "a missing $guide is found";
    like $err, /"Missing .github/$guide"/, "the failure names $guide";
    $file.spurt($text);
}

$link.unlink;
put('CLAUDE.md', "# Agents\n");
($status, $out, $err) = check();
isnt $status, 0, 'a CLAUDE.md that is not a symlink is found';
like $err, /'relative AGENTS.md symlink'/, 'the failure names the symlink rule';
link-agents($root.add('AGENTS.md').Str);
($status, $out, $err) = check();
isnt $status, 0, 'an absolute CLAUDE.md symlink is found';
like $err, /'relative AGENTS.md symlink'/, 'the absolute link fails the same rule';
link-agents();

put('lib/Extra.rakumod', "use v6.d;\nunit module Extra;\n");
($status, $out, $err) = check();
isnt $status, 0, 'a module missing from META6.json provides is found';
like $err, /'provides does not match'/, 'the inventory failure names provides';

done-testing;
