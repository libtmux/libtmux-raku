root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4

[*.{json,mjs,yml,yaml}]
indent_size = 2

[*.{rakumod,rakutest,raku,rakudoc,md}]
# Whitespace can be literal data in Raku heredocs and documentation examples.
trim_trailing_whitespace = false
