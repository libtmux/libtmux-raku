use v6.d;
use Test;
use Test::LibTmux::Fixture;
use LibTmux::Engine;
use LibTmux::Model;
use LibTmux::Exceptions;
use LibTmux::Types;

# Outer: linked windows, session groups and explicit command effects require tmux.
with-tmux(-> $fixture {
    my $runtime = Runtime.new(:endpoint(Endpoint.new(:binary($fixture.binary),
        :socket-path($fixture.socket-path.Str), :config-file('/dev/null'))));
    LEAVE $runtime.close;
    $fixture.cmd('new-session', '-d', '-s', 'second', 'exec cat');
    $fixture.cmd('link-window', '-s', '@0', '-t', '$0:4');
    $fixture.cmd('link-window', '-s', '@0', '-t', '$1:3');
    my $snapshot = capture($runtime);
    is $snapshot.windows.elems, 2, 'global windows deduplicate linked physical identity';
    is $snapshot.panes.elems, 2, 'global panes deduplicate linked physical identity';
    is $snapshot.window-links.elems, 4, 'all four placements are retained';
    is $snapshot.windows.where(%(id => '@0')).single.links.elems, 3,
        'same window has two links in one session and one in another';
    my $original = $snapshot.sessions.where(%(id => '$0')).single;
    $original.ref.rename('night-shift');
    is $original.name, 'fixture', 'mutation leaves captured values unchanged';
    is $original.ref.inspect.name, 'night-shift', 'inspection explicitly acquires current data';
    my $link = $original.window-links.where(%(index => 4)).single;
    $fixture.cmd('move-window', '-s', '$0:4', '-t', '$0:5');
    throws-like { $link.ref.select }, X::LibTmux::StaleReference,
        'link reference refuses a renumbered placement';
    $fixture.cmd('new-session', '-d', '-s', 'grouped', '-t', '$0');
    my $grouped = capture($runtime);
    is $grouped.session-groups.elems, 1, 'session group is represented explicitly';
    is $grouped.session-groups.single.sessions.elems, 2, 'group resolves its member sessions';
    my $pane = $grouped.panes.where(%(id => '%0')).single;
    subtest 'panes without a child process remain in captured graphs' => {
        my @empty = $pane.ref.split(:empty);
        @empty.push($pane.ref.new-floating(:width(20), :height(8), :empty))
            if $grouped.capabilities.supports('pane-floating');
        LEAVE .kill for @empty;
        my @pids = @empty.map({ $fixture.cmd('display-message', '-p', '-t', .id, '#{pane_pid}').chomp });
        my $captured;
        lives-ok { $captured = capture($runtime) }, 'empty tiled and available floating panes can be captured';
        if $captured.defined {
            for @empty.kv -> $index, $reference {
                my $view = $captured.panes.where(%(id => $reference.id)).single;
                if @pids[$index].chars {
                    is $view.pid, @pids[$index].Int, 'legacy numeric process evidence remains unchanged';
                } else {
                    is $view.state('pid'), KnownNull, 'missing process evidence is domain null';
                    nok $view.pid.defined, 'a pane without a process has no fabricated PID';
                    is $view.state('current-path'), KnownNull, 'a missing process cwd is domain null';
                    is $captured.panes.where(%(id => $reference.id,
                        pid => %(is-null => True), current-path => %(is-null => True))).single.id,
                        $reference.id, 'absent process fields participate in validated criteria';
                }
            }
        }
    };
    $runtime.close;
    is $pane.window.id, '@0', 'retained graph resolves relationships after owner close';
    is $pane.snapshot.windows.elems, 2, 'retained graph enumerates after owner close';
    isa-ok $pane.ref, PaneRef, 'reference value construction does not retain the old owner';
});

done-testing;
